# Clé API Anthropic pour les recommandations intelligentes avec Claude (frontend)
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Clé API Anthropic pour l'analyse d'image BAHRIA Cam (backend)
# IMPORTANT: Cette clé est utilisée côté serveur pour la sécurité
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Configuration Supabase (optionnel - mode démo disponible sans compte)
# Créez un projet gratuit sur https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Port du serveur API (optionnel, défaut: 3001)
PORT=3001

# Pour obtenir vos clés Supabase :
# 1. Créez un compte sur https://supabase.com
# 2. Créez un nouveau projet
# 3. Dans Settings > API, copiez :
#    - Project URL → VITE_SUPABASE_URL
#    - Project API keys (anon/public) → VITE_SUPABASE_ANON_KEY

# IMPORTANT : Ne partagez jamais ce fichier ni vos clés !
